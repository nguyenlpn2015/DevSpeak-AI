# DevSpeak AI - Backend Configuration (.env.example)

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="DevSpeak AI API"
API_V1_STR=/api/v1

# Server Bindings
HOST=127.0.0.1
PORT=8000

# Database Configuration (Defaults to local SQLite; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./devspeak.db
DATABASE_ECHO=false

# AI Provider ("mock", "openai", "anthropic", "gemini")
AI_PROVIDER=mock

# Live AI Keys (Leave blank when AI_PROVIDER=mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Rate Limits / Quotas
DAILY_QUESTION_QUOTA=20
MAX_ANSWER_LENGTH=4000
