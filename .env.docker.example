# ==============================================================================
# DevSpeak AI - Docker Environment Configuration (.env.docker.example)
# Copy to .env or pass to docker compose: `docker compose --env-file .env.docker up`
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=devspeak
POSTGRES_PASSWORD=devspeak_local_secret
POSTGRES_DB=devspeak

# AI Provider Configuration
# Set to 'mock' for 100% offline, zero-cost development
# Set to 'gemini' for real evaluation using Google AI Studio
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Networking & Ports
PORT_API=8000
PORT_WEB=3001

