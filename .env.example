# ==============================================================================
# DevSpeak AI — Monorepo Root Environment Configuration Template (.env.example)
# ==============================================================================
# This template documents environment variables across all services for local 
# development (Docker Compose) and cloud deployment references.
#
# Specific app templates:
# - Backend: apps/api/.env.example
# - Frontend: apps/web/.env.example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (apps/api)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="DevSpeak AI API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (Docker Compose uses postgres:5432; local dev defaults to SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/devspeak
DATABASE_ECHO=false

# AI Provider Selection ("mock" [default, zero cost], "gemini", "openai", "anthropic")
AI_PROVIDER=mock

# Live AI API Keys (Optional; leave empty when AI_PROVIDER=mock)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2

# Authentication & JWT Configuration
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001"

# Rate Limits / Quotas
DAILY_QUESTION_QUOTA=20
MAX_ANSWER_LENGTH=4000

# ------------------------------------------------------------------------------
# 2. Frontend Web Service Configuration (apps/web)
# ------------------------------------------------------------------------------
# URL used by the candidate browser to reach the backend REST API
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Database Credentials (PostgreSQL Container for Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devspeak
POSTGRES_PORT=5432
